{
  "name": "Kaastro Pay — Receive crypto. Spend in Naira.",
  "short_name": "Kaastro Pay",
  "description": "Receive supported crypto, converted to Naira automatically after confirmation, and withdraw straight to your bank.",
  "id": "/",
  "start_url": "./dashboard/index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "portrait",
  "background_color": "#0A0A0A",
  "theme_color": "#0A0A0A",
  "categories": ["finance", "business"],
  "lang": "en",
  "dir": "ltr",
  "icons": [
    { "src": "images/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "images/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "images/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "images/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "screenshots": [
    {
      "src": "images/screenshot-mobile.jpg",
      "sizes": "1080x1920",
      "type": "image/jpeg",
      "form_factor": "narrow",
      "label": "Your Naira balance and recent activity on the Kaastro Pay home screen"
    }
  ],
  "shortcuts": [
    {
      "name": "Deposit",
      "short_name": "Deposit",
      "url": "./dashboard/deposit.html",
      "icons": [{ "src": "images/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Withdraw",
      "short_name": "Withdraw",
      "url": "./dashboard/withdraw.html",
      "icons": [{ "src": "images/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Scan & Pay",
      "short_name": "Scan",
      "url": "./dashboard/scan.html",
      "icons": [{ "src": "images/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Today's Rates",
      "short_name": "Rates",
      "url": "./dashboard/rates.html",
      "icons": [{ "src": "images/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "prefer_related_applications": false
}
